# Copy to .env and fill in what you use. Git ignores .env, and nothing here
# prints or logs its values. Details: docs/CONFIGURATION.md
#
# Comments must be on their own line: everything after = is the value.

# --- AO3 account: harvest_links.py, download_fics.py ---
AO3_USERNAME=
AO3_PASSWORD=

# --- BookOrbit: send_to_server.py (required); harvest and download use it to
#     skip works you already have. Leave BOOKORBIT_URL empty to go without. ---
# e.g. myserver:8080
BOOKORBIT_URL=
# A dedicated account with only "Edit metadata" and "Download".
BOOKORBIT_USERNAME=
BOOKORBIT_PASSWORD=
# Optional: an accessToken instead of the account (expires in 15 minutes).
# BOOKORBIT_TOKEN=
# Optional: look at one library only.
# BOOKORBIT_LIBRARY_ID=

# --- Server: send_to_server.py, backup_server.py ---
# The server's alias in ~/.ssh/config, e.g. myserver
SERVER=
# BookOrbit's folder on the server (the backup copies all of it), e.g. /srv/bookorbit
SERVER_BOOKORBIT_DIR=
# Where new books go (the backup copies it too), e.g. /srv/books/fanfiction
SERVER_LIBRARY_DIR=
# That same folder as BookOrbit's container sees it, e.g. /books/fanfiction
# (the two sides of its docker volume: /srv/books -> /books)
BOOKORBIT_LIBRARY_PATH_IN_CONTAINER=
# The folder on this PC to back up into, e.g. ~/Backups
BACKUP_DIR=
