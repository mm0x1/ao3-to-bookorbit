# Copy to .env and fill in. The real .env is ignored by Git, and no tool here
# ever prints, logs, or stores these values.

AO3_USERNAME=
AO3_PASSWORD=

# BookOrbit: send_to_server.py needs it, and download_fics.py uses it to know
# which works are already on the server. Leave BOOKORBIT_URL empty and the
# download still works, treating every work as new.
#
# BookOrbit has no API keys. Either sign in with a dedicated account, which is
# the easy option because the sync mints and renews its own token, or paste an
# accessToken, which expires after JWT_EXPIRES_IN (15 minutes by default).
# Give the account only "Edit metadata" and "Download", not admin.
BOOKORBIT_URL=
BOOKORBIT_USERNAME=
BOOKORBIT_PASSWORD=
# BOOKORBIT_TOKEN=
# BOOKORBIT_LIBRARY_ID=

# The server the library lives on, for send_to_server.py and backup_server.py.
# Nothing here has a default and no tool ever writes this file. Keep comments on
# their own line: anything after the = is part of the value.
#
# The server's alias in ~/.ssh/config, for example: myserver
SERVER=
# BookOrbit's folder on the server; backup_server.py copies all of it.
# An absolute path, for example: /path/to/bookorbit
SERVER_BOOKORBIT_DIR=
# The folder inside it that send_to_server.py adds new books to,
# for example: /path/to/bookorbit/fanfiction
SERVER_LIBRARY_DIR=
# SERVER_LIBRARY_DIR as BookOrbit's container sees it: the start of the file
# paths BookOrbit reports, for example: /books/fanfiction
BOOKORBIT_LIBRARY_PATH_IN_CONTAINER=
# The folder on this PC the backup goes into, for example: ~/Backups/bookorbit
BACKUP_DIR=
